# Copy to .env and adjust.  (Windows: Copy-Item .env.example .env)

# Initial web admin account (only used when no admin exists yet).
# If ADMIN_PASSWORD is empty, a random password is written to
# /data/config/initial-admin-password inside the config volume.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-2026!

# Host ports: http://localhost/svn/<repo>, http://localhost/admin
SVNGO_HTTP_PUBLISH=80
SVNGO_HTTPS_PUBLISH=443

# Public host name (Apache ServerName)
SVNGO_SERVER_NAME=localhost

# Session cookie Secure flag: auto (HTTPS / X-Forwarded-Proto) | always | never
SVNGO_COOKIE_SECURE=auto

# bcrypt cost for SVN user passwords (Apache checks it on every SVN request)
SVNGO_BCRYPT_COST=8

# Max size of one SVN HTTP request (a commit sends one PUT per file), MB.
# 0 = unlimited, max 2047. XML bodies (REPORT/PROPFIND/MERGE) separately.
SVNGO_SVN_MAX_BODY_MB=1024
SVNGO_SVN_MAX_XML_MB=64

TZ=Asia/Seoul
